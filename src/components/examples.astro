---
import pt from "../locales/pt_BR.json"
import example1 from "../assets/images/gallery-01.webp"
import example2 from "../assets/images/gallery-02.webp"
import example3 from "../assets/images/gallery-03.webp"
import example4 from "../assets/images/gallery-04.webp"
import example5 from "../assets/images/gallery-05.webp"
import example6 from "../assets/images/gallery-06.webp"
const t = pt.examples

// Função para gerar srcset responsivo
function generateSrcSet(image: any, baseWidth: number) {
  const widths = [baseWidth, baseWidth * 1.5, baseWidth * 2];
  return widths.map(w => `${image.src} ${w}w`).join(', ');
}

const examples = [
	{
		src: example1,
		alt: "Ensaio IA - Foto de Perfil Elegante",
		category: "Elegante",
		baseWidth: 412,
		baseHeight: 618
	},
	{
		src: example2,
		alt: "Ensaio IA - Foto de Perfil Fotográfico",
		category: "Fotográfico",
		baseWidth: 412,
		baseHeight: 618
	},
	{
		src: example3,
		alt: "Ensaio IA - Foto de Perfil",
		category: "Perfil",
		baseWidth: 412,
		baseHeight: 618
	},
	{
		src: example4,
		alt: "Ensaio IA - Foto de Perfil ao Ar Livre",
		category: "Ar Livre",
		baseWidth: 412,
		baseHeight: 618
	},
	{
		src: example5,
		alt: "Ensaio IA - Foto de Perfil Casual",
		category: "Casual",
		baseWidth: 412,
		baseHeight: 618
	},
	{
		src: example6,
		alt: "Ensaio IA - Foto de Perfil Business",
		category: "Business",
		baseWidth: 412,
		baseHeight: 618
	},
] satisfies { src: ImageMetadata; alt: string; category: string; baseWidth: number }[]
---
<section id="examples" class="w-full py-24 flex flex-col items-center justify-center bg-transparent relative">
  <!-- Background glow -->
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 left-0 w-[300px] h-[300px] rounded-full bg-[#00D9FF] opacity-5 blur-[80px]"></div>
    <div class="absolute bottom-1/3 right-0 w-[300px] h-[300px] rounded-full bg-[#EEFF00] opacity-5 blur-[80px]"></div>
  </div>

  <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-4 bg-gradient-to-r from-[#00D9FF] to-[#EEFF00] bg-clip-text text-transparent relative z-10">
    {t.title}
  </h2>
  <p class="text-[#9CA3AF] text-center max-w-2xl mb-12 text-lg leading-relaxed relative z-10 px-4">
    {t.intro}
  </p>
  <div class="columns-1 sm:columns-2 lg:columns-3 gap-5 w-full max-w-6xl space-y-5 px-4 relative z-10">
    {examples.map((example) => (
      <div class="relative mb-5 break-inside-avoid rounded-2xl overflow-hidden group border border-[#00D9FF]/10 hover:border-[#00D9FF]/40 transition-all duration-300" style="box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);">
        <img
          src={example.src.src}
          alt={example.alt}
          class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          width={example.baseWidth}
          height={example.baseHeight}
          decoding="async"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          srcset={generateSrcSet(example.src, example.baseWidth)}
        />
        <span class="absolute top-3 left-3 px-3 py-1.5 rounded-full text-xs font-bold bg-[rgba(10,10,12,0.85)] text-[#00D9FF] backdrop-blur-sm border border-[#00D9FF]/30">
          {example.category}
        </span>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0C]/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
      </div>
    ))}
  </div>
</section> 
