---
import pt from "../locales/pt_BR.json";
import websiteCover from "../assets/images/website-cover.webp";
import websiteCover2x from "../assets/images/website-cover@2x.webp";
import websiteCoverThumbnail from "../assets/images/website-cover-thumb.webp";
import websiteCoverThumbnail2x from "../assets/images/website-cover-thumb@2x.webp";
const t = pt.hero;
---
<section
	class="hero-section relative flex items-center justify-center min-h-screen w-full overflow-hidden px-4"
>
	<!-- Background effects com cores do logo -->
	<div aria-hidden="true" class="absolute inset-0 pointer-events-none z-0">
		<div class="absolute -top-32 -left-32 w-[500px] h-[500px] rounded-full bg-[#00D9FF] opacity-15 blur-[100px]"></div>
		<div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-[#EEFF00] opacity-10 blur-[80px]"></div>
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full bg-[#00D9FF] opacity-5 blur-[120px]"></div>
	</div>

	<div class="w-full relative z-10 max-w-[1200px]">
		<div class="w-full grid lg:grid-cols-2 gap-8 lg:gap-12 max-lg:mt-12">
			<div class="flex flex-col items-center text-center max-lg:mb-4">
				<h1 class="text-4xl md:text-6xl font-extrabold mb-6 tracking-tight bg-gradient-to-r from-[#00D9FF] via-white to-[#EEFF00] bg-clip-text text-transparent">
					{t.headline}
				</h1>
				<p class="text-lg md:text-2xl text-[#9CA3AF] mb-8 leading-relaxed">
					{t.subtitle}
				</p>
				<a
					href="#about"
					class="inline-block px-10 py-4 rounded-full font-bold uppercase text-lg bg-[#EEFF00] text-[#0A0A0C] hover:bg-[#00D9FF] hover:text-[#0A0A0C] shadow-xl transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#00D9FF] focus:ring-offset-2 focus:ring-offset-[#0A0A0C]"
					style="box-shadow: 0 0 20px rgba(238, 255, 0, 0.4), 0 0 40px rgba(0, 217, 255, 0.2);"
				>
					{t.cta}
				</a>
				<span class="mt-6 text-sm text-[#00D9FF] font-medium">{t.trust}</span>
			</div>
			<div class="relative flex items-center justify-center max-lg:mb-12">
				<div class="absolute top-1/3 left-0 w-[140px] p-2 bg-[#141418] border border-[#00D9FF]/20 rounded-lg shadow-lg z-10" style="box-shadow: 0 0 16px rgba(0, 217, 255, 0.15);">
					<img
						src={websiteCoverThumbnail.src}
						alt={t.thumbnail_alt}
						class="w-full h-full object-cover rounded"
						srcset={`${websiteCoverThumbnail2x.src} 2x`}
						width={140}
						height={140}
						loading="eager"
						fetchpriority="high"
						decoding="sync"
					/>
					<span class="w-full text-[#9CA3AF] text-xs mt-1 block">
						{t.thumbnail_desc}
					</span>
				</div>
				<div class="p-3 bg-[#141418] w-3/4 shadow-xl rounded-lg border border-[#EEFF00]/20 space-y-2" style="box-shadow: 0 0 24px rgba(238, 255, 0, 0.1);">
					<img
						src={websiteCover.src}
						alt={t.cover_alt}
						class="w-full h-full object-cover rounded"
						srcset={`${websiteCover.src} 928w, ${websiteCover2x.src} 1856w`}
						sizes="(max-width: 928px) 100vw, 928px"
						width={253}
						height={314}
						loading="eager"
						fetchpriority="high"
						decoding="sync"
					/>
					<span class="text-[#EEFF00] font-semibold text-sm">
						{t.cover_desc}
					</span>
				</div>
			</div>
		</div>
	</div>
</section> 
