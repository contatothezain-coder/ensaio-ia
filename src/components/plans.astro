---
import pt from "../locales/pt_BR.json";
const t = pt.plans;
const plans = t.plans;
const whatsappLink = import.meta.env.PUBLIC_WHATSAPP_LINK;
---
<section id="plans" class="w-full py-24 flex flex-col items-center justify-center bg-transparent relative">
  <!-- Background glow -->
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-1/4 w-[400px] h-[400px] rounded-full bg-[#EEFF00] opacity-5 blur-[100px]"></div>
    <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] rounded-full bg-[#00D9FF] opacity-5 blur-[100px]"></div>
  </div>
  
  <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-4 bg-gradient-to-r from-[#EEFF00] to-[#00D9FF] bg-clip-text text-transparent relative z-10">
    {t.title}
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-5xl mt-12 px-4 relative z-10">
    {plans.map((plan, i) => (
      <div class={[
        'relative flex flex-col items-center bg-[#141418] rounded-2xl p-8 transition-all duration-300',
        plan.badge ? 'border-2 border-[#EEFF00] scale-105 z-10' : 'border border-[#00D9FF]/20',
        'hover:scale-[1.02] hover:-translate-y-1',
      ].join(' ')} style={plan.badge ? 'box-shadow: 0 0 40px rgba(238, 255, 0, 0.2);' : ''}>
        {plan.badge && (
          <span class="absolute -top-4 left-1/2 -translate-x-1/2 px-5 py-1.5 rounded-full text-xs font-bold bg-[#EEFF00] text-[#0A0A0C] shadow-lg z-20">
            {plan.badge}
          </span>
        )}
        <div class="text-2xl font-extrabold mb-2 text-[#00D9FF] text-center">{plan.name}</div>
        <div class="text-4xl font-extrabold mb-2 text-[#F5F5F5] text-center">{plan.price}</div>
        <div class="text-base text-[#9CA3AF] mb-6 text-center">{plan.desc}</div>
        <ul class="flex flex-col gap-3 mb-8 w-full">
          {plan.benefits.map(benefit => (
            <li class="flex items-center gap-3 text-[#F5F5F5] text-sm md:text-base">
              <svg class="w-5 h-5 text-[#00D9FF] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener"
          class={[
            'w-full text-center rounded-full font-bold py-3 px-6 transition-all duration-300 mt-auto',
            plan.badge
              ? 'bg-[#EEFF00] text-[#0A0A0C] hover:bg-[#00D9FF] focus:ring-2 focus:ring-[#00D9FF] focus:ring-offset-2 focus:ring-offset-[#0A0A0C]'
              : 'border-2 border-[#00D9FF] text-[#00D9FF] bg-transparent hover:bg-[#00D9FF] hover:text-[#0A0A0C] focus:ring-2 focus:ring-[#EEFF00] focus:ring-offset-2 focus:ring-offset-[#0A0A0C]',
          ].join(' ')}
          style={plan.badge ? 'box-shadow: 0 0 16px rgba(238, 255, 0, 0.3);' : 'box-shadow: 0 0 12px rgba(0, 217, 255, 0.15);'}
        >
          {plan.cta}
        </a>
      </div>
    ))}
  </div>
</section> 
