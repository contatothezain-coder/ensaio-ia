---
import pt from "../locales/pt_BR.json";
const t = pt.footer;
const year = new Date().getFullYear();
---
<footer class="w-full border-t border-[rgba(0,217,255,0.1)] bg-[#0A0A0C] text-[#9CA3AF] text-sm py-8 px-4 flex flex-col md:flex-row items-center justify-between gap-4">
  <div class="flex items-center gap-2">
    <span>{t.copyright.replace('{year}', year)}</span>
  </div>
  <nav class="flex items-center gap-6 flex-wrap justify-center max-lg:flex-col max-lg:gap-3">
    {t.links.map(link => (
      <a href={link.href} class="hover:text-[#00D9FF] transition-colors duration-200 cursor-pointer">{link.label}</a>
    ))}
    <a href="#" class="ml-2 text-[#9CA3AF] hover:text-[#EEFF00] transition-colors duration-200" aria-label={t.instagram}>
      <svg class="w-5 h-5 inline-block align-middle" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1.5"/></svg>
    </a>
  </nav>
</footer> 
