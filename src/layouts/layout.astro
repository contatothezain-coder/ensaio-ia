---
import "./../assets/styles/global.css";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import { AstroFont } from "astro-font";

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const facebookPixel = import.meta.env.PUBLIC_FACEBOOK_PIXEL;
const googleTagManager = import.meta.env.PUBLIC_GOOGLE_TAGMANAGER_TAG;
---
<!DOCTYPE html>
<html lang="pt-BR" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content="Astro" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="ensaio fotográfico, inteligência artificial, fotos IA, fotógrafo virtual, estúdio IA, fotografia digital, inovação, tecnologia, retrato, criativo" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://ensaioia.com.br" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/banner.svg" />

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://ensaioia.com.br" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content="/banner.svg" />

		<!-- CSS Crítico Otimizado para LCP -->
		<style>
			:root {
				--color-background: #0A0A0C;
				--color-primary: #141418;
				--color-text-base: #F5F5F5;
				--color-text-muted: #9CA3AF;
				--color-accent-primary: #00D9FF;
				--color-accent-secondary: #EEFF00;
				--color-accent-pink: #EEFF00;
				--color-accent-blue: #00D9FF;
				font-family: 'Poppins', system-ui, sans-serif;
			}

			html {
				background: #0A0A0C;
				color: #F5F5F5;
				font-family: 'Poppins', system-ui, sans-serif;
				min-height: 100%;
				scroll-behavior: smooth;
				color-scheme: dark;
			}

			body {
				background: #0A0A0C;
				color: #F5F5F5;
				font-family: 'Poppins', system-ui, sans-serif;
				min-height: 100vh;
				letter-spacing: 0.01em;
				-webkit-font-smoothing: antialiased;
			}

			/* Header crítico para LCP */
			header { 
				position: sticky;
				top: 0;
				z-index: 50;
				width: 100%;
				backdrop-filter: blur(12px);
				background: rgba(10, 10, 12, 0.9);
				border-bottom: 1px solid rgba(0, 217, 255, 0.12);
				box-shadow: 0 4px 24px rgba(0, 217, 255, 0.08);
			}
			
			/* Hero section */
			.hero-section { 
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				background: linear-gradient(135deg, #0A0A0C 0%, #141418 50%, #0A0A0C 100%);
			}
		</style>

		<link rel="dns-prefetch" href="//wa.me" />
		<link rel="preconnect" href="https://wa.me" />
		
		{googleTagManager && (
			<script type="text/partytown" define:vars={{ gtmId: googleTagManager }}>
				(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
				new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
				j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
				'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
				})(window,document,'script','dataLayer',gtmId);
			</script>
		)}

		{facebookPixel && (
			<script type="text/partytown" define:vars={{ pixelId: facebookPixel }}>
				!function(f,b,e,v,n,t,s)
				{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
				n.callMethod.apply(n,arguments):n.queue.push(arguments)};
				if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
				n.queue=[];t=b.createElement(e);t.async=!0;
				t.src=v;s=b.getElementsByTagName(e)[0];
				s.parentNode.insertBefore(t,s)}(window, document,'script',
				'https://connect.facebook.net/en_US/fbevents.js');
				fbq('init', pixelId);
				fbq('track', 'PageView');
			</script>
		)}
		
		<AstroFont
			config={[
				{
					name: "Poppins",
					src: [
						{
							style: 'normal',
							weight: 400,
							path: './public/fonts/poppins/Poppins-Regular.ttf',
						},
						{
							style: 'semibold',
							weight: 600,
							path: './public/fonts/poppins/Poppins-SemiBold.ttf',
						},
						{
							style: 'bold',
							weight: 700,
							path: './public/fonts/poppins/Poppins-Bold.ttf',
						},
					],
					preload: true,
					display: 'swap',
					selector: 'body',
					fallback: 'sans-serif',
				}
			]}
		/>
  </head>
  <body>
		{googleTagManager && (
			<noscript>
				<iframe src={`https://www.googletagmanager.com/ns.html?id=${googleTagManager}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
			</noscript>
		)}

    <Header />
    <slot />
    <Footer />
  </body>
</html> 
